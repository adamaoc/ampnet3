# Public FlexHub API. The works fetch and the contact form both use this host.
# Production builds default to https://flexhub.ampnet.media/api when this is unset.
# `npm run dev` posts the contact form to http://localhost:3005/api unless this is set.
# A production build whose API URL is localhost refuses to submit and tells the visitor to email instead.
# NEXT_PUBLIC_API_URL=https://flexhub.ampnet.media/api

# Site that owns the public works feed (Photopti, W-Ink). Read only by scripts/fetch-build-data.mjs.
# NEXT_PUBLIC_WORKS_SITE_ID=396fda62-3465-4da0-a934-b82272819e99

# Site that receives contact-form posts. Read only by the contact page.
# NEXT_PUBLIC_CONTACT_SITE_ID=8ad1bc58-fdb0-44ac-b021-251a06bd2bec

# NEXT_PUBLIC_SITE_ID is not read. Works and contact use the two variables above
# so one override cannot point both at the wrong site.

# AmpGauge page views. Set both at production build time only.
# Leave unset for local development and preview builds.
# NEXT_PUBLIC_AMPGAUGE_SRC=https://gauge.ampnet.media/t.js
# NEXT_PUBLIC_AMPGAUGE_SITE=ampnet
